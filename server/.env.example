# MongoDB must be a replica set (transactions). Atlas works as-is.
MONGO_URI=mongodb://127.0.0.1:27017/argus?replicaSet=rs0
PORT=3001
# Comma-separated browser origins allowed for REST + WebSocket
CLIENT_ORIGIN=http://localhost:5173

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=15000

# Auth: use a long random string in production
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# npm run seed
SEED_ADMIN_EMAIL=admin@argus.local
SEED_ADMIN_PASSWORD=
SEED_CITIZEN_EMAIL=citizen@argus.local
SEED_CITIZEN_PASSWORD=
